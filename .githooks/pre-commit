#!/usr/bin/env bash
set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
BOLD='\033[1m'
RESET='\033[0m'

pass() { echo -e "${GREEN}✔${RESET} $1"; }
fail() { echo -e "${RED}✖ $1${RESET}"; FAILED=1; }
warn() { echo -e "${YELLOW}⚠ $1${RESET}"; }
header() { echo -e "\n${BOLD}$1${RESET}"; }

FAILED=0

# Staged .ts / .tsx files only
STAGED=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx)$' || true)

if [ -z "$STAGED" ]; then
  warn "No staged TypeScript files — skipping lint and structure checks"
else

  # ─── 1. ESLint (staged files only) ─────────────────────────────────────────
  header "1/4  ESLint"
  if npx eslint $STAGED 2>&1; then
    pass "No lint errors in staged files"
  else
    fail "Lint errors found in staged files"
  fi

  # ─── 2. TypeScript (whole project) ────────────────────────────────────────
  header "2/4  TypeScript"
  if npx tsc --noEmit 2>&1; then
    pass "No type errors"
  else
    fail "TypeScript errors found — run 'npx tsc --noEmit' to see details"
  fi

  # ─── 3. Code-structure checks (staged files only) ─────────────────────────
  header "3/4  Code structure"

  # 3a. Relative imports
  RELATIVE=$(grep -n "from '\.\." $STAGED 2>/dev/null || true)
  RELATIVE+=$(grep -n 'from "\.\.' $STAGED 2>/dev/null || true)
  if [ -n "$RELATIVE" ]; then
    fail "Relative imports found — use the @/ alias instead:"
    echo "$RELATIVE"
  else
    pass "No relative imports"
  fi

fi

# ─── 4. Tests ────────────────────────────────────────────────────────────────
header "4/4  Tests"
if grep -q '"test"' package.json 2>/dev/null; then
  if npm run test --silent 2>&1; then
    pass "All tests passed"
  else
    fail "Tests failed — run 'npm test' to see details"
  fi
else
  warn "No test script configured — skipping"
fi

# ─── Result ──────────────────────────────────────────────────────────────────
echo ""
if [ "$FAILED" -eq 1 ]; then
  echo -e "${RED}${BOLD}Pre-commit failed. Fix the issues above before committing.${RESET}"
  exit 1
else
  echo -e "${GREEN}${BOLD}All checks passed.${RESET}"
  exit 0
fi
